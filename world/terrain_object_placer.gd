extends Node3D
## Places the house beyond the central hill and keeps the house/trunk grounded
## against the procedural terrain generated by terrain.gd.

@export var terrain_path: NodePath = NodePath("../Terrain")
@export var house_path: NodePath = NodePath("../House")
@export var trunk_path: NodePath = NodePath("../Den")

@export_group("Placement")
## Negative X puts the house on the far side of the hill from the den.
@export var house_position: Vector3 = Vector3(-55.0, 0.0, 0.0)
@export var trunk_position: Vector3 = Vector3(0.0, 0.0, -4.1468706)
@export var house_yaw_degrees: float = -90.0
@export var trunk_yaw_degrees: float = 0.0
@export var house_height_offset: float = 0.0
@export var trunk_height_offset: float = 0.0

@export_group("Terrain alignment")
@export var align_to_surface: bool = true
@export var normal_sample_distance: float = 1.0

func _ready() -> void:
	# terrain.gd builds its height data in _ready(). Defer once so this script
	# always runs after that data and its collision shape are available.
	call_deferred("place_objects")

func place_objects() -> void:
	var terrain := get_node_or_null(terrain_path)
	if terrain == null or not terrain.has_method("get_height_at"):
		push_error("TerrainObjectPlacer needs a terrain with get_height_at().")
		return

	_place(get_node_or_null(house_path), terrain, house_position, house_yaw_degrees, house_height_offset)
	_place(get_node_or_null(trunk_path), terrain, trunk_position, trunk_yaw_degrees, trunk_height_offset)

func _place(item: Node3D, terrain: Node, point: Vector3, yaw_degrees: float, height_offset: float) -> void:
	if item == null:
		push_warning("TerrainObjectPlacer could not find one of its placement targets.")
		return

	var ground_y: float = terrain.get_height_at(point.x, point.z) + height_offset
	var surface_normal := Vector3.UP
	if align_to_surface and terrain.has_method("get_normal_at"):
		surface_normal = terrain.get_normal_at(point.x, point.z, normal_sample_distance)

	var yaw_basis := Basis(Vector3.UP, deg_to_rad(yaw_degrees))
	var surface_basis := Basis(Quaternion(Vector3.UP, surface_normal))
	item.global_basis = surface_basis * yaw_basis
	item.global_position = Vector3(point.x, ground_y, point.z)
